# ==========================================
# StudyOS AI — Root .gitignore
# ==========================================

# Sensitive Environment Configurations
*.env
*.env.*
!.env.example
!backend/.env.example
!frontend/.env.example
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Databases & SQLite
*.db
*.sqlite
*.sqlite3
backend/studyos.db

# User Uploads & Media
backend/uploads/
uploads/

# Archive files & Large bundles
*.zip
*.tar.gz
*.rar
frontend.zip

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
!frontend/lib/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/

# Node & Next.js (Frontend)
node_modules/
frontend/node_modules/
.next/
frontend/.next/
frontend/out/
.pnp
.pnp.js
coverage/
*.tsbuildinfo
next-env.d.ts

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & IDE Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
