# Environment Variables — StudyOS AI Backend

# ─── DATABASE ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://studyos_user:studyos_pass@localhost:5432/studyos_db

# ─── SECURITY ────────────────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── EMAIL (SMTP) ────────────────────────────────────────────────────────────
# To receive OTPs in your real Gmail inbox:
# 1. Enable 2-Step Verification on your Google Account (https://myaccount.google.com/security)
# 2. Generate a 16-letter App Password at: https://myaccount.google.com/apppasswords
# 3. Paste your Gmail and App Password below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=abcd-efgh-ijkl-mnop
EMAIL_FROM=StudyOS AI <your-email@gmail.com>
# Note: If left blank, StudyOS AI runs in local Dev Mode and displays OTP directly in the UI!


# ─── AI / LLM ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: Google Gemini fallback
# GEMINI_API_KEY=AIza...

# ─── FILE STORAGE ────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# ─── APP SETTINGS ────────────────────────────────────────────────────────────
APP_NAME=StudyOS AI
APP_VERSION=1.0.0
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ─── OTP SETTINGS ────────────────────────────────────────────────────────────
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ─── DEVELOPMENT ─────────────────────────────────────────────────────────────
# Set to "true" ONLY for local development when SMTP is unavailable
# OTPs will be printed to console. NEVER set true in production.
DEMO_MODE=false

# ─── REDIS (optional, for background tasks) ──────────────────────────────────
# REDIS_URL=redis://localhost:6379/0
